# Dev-only values for TestDeployPublic (scripts/qualify.sh) in place of deploy/public/example.env. The regtest network
# already holds 172.30.78.0/24, so the bundle's own network uses the documentation range here. qualify.sh gives
# SATBOOTH_ETC and SATBOOTH_BACKUPS (temporary host directories) from its environment.
PUBLIC_ADDR=127.0.0.1
PUBLIC_PORT=19101
SATBOOTH_SUBNET=192.0.2.0/24
SATBOOTH_IP=192.0.2.40
