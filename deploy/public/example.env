# Operator values for deploy/public/compose.yml (docker compose --env-file). Addresses and paths only: no secret goes in
# this file. Copy it, change every value, and keep the copy outside the repository. The README lists every value.

# Where the checkout page (the public listener) is published: the one published port of this host. 127.0.0.1 when a
# TLS reverse proxy on this host serves checkout_base_url; the host's public address when nothing is in front.
PUBLIC_ADDR=127.0.0.1
PUBLIC_PORT=8080

# The bundle's own Docker network and SatBooth's fixed address on it. In satbooth.json, public_listen is
# SATBOOTH_IP:8080 and private_listen SATBOOTH_IP:8081 (SatBooth refuses a wildcard listener).
SATBOOTH_SUBNET=172.30.78.0/24
SATBOOTH_IP=172.30.78.40

# Host directory with satbooth.json and the secret files it names (each 0600), mounted read-only at /etc/satbooth:
# the paths in satbooth.json start with /etc/satbooth/. volume-init gives the directory and its files to 65532.
SATBOOTH_ETC=/srv/satbooth/etc

# Host directory for satbooth backup (mounted at /backups in satbooth-oneoff only).
SATBOOTH_BACKUPS=/srv/satbooth/backups
