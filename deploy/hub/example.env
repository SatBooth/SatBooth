# Operator values for deploy/hub/compose.yml (docker compose --env-file). Addresses and paths only: no secret goes in
# this file. Copy it, change every value, and keep the copy outside the repository. The README lists every value.

# The hub host's address on the private link to the public host (WireGuard or a private network). It carries only what
# SatBooth calls: the relay's client listener (7448), bitcoind's RPC (8332) and, with the monero profile, wallet-rpc
# (18083).
HUB_PRIVATE_ADDR=192.0.2.20

# Where the hub's admin UI (8080) is published: loopback, reached with ssh -L 8080:127.0.0.1:8080 <hub host>. Never
# HUB_PRIVATE_ADDR or a public address: the UI controls the node's funds, and a fresh hub belongs to whoever opens it
# first.
HUB_ADMIN_ADDR=127.0.0.1

# The bundle's own Docker network and the fixed address of the hub and the relay on it. The relay's client_listen in
# relay.json is HUB_IP:7448 (the relay refuses a wildcard). bitcoin.conf allows RPC from HUB_SUBNET.
HUB_SUBNET=172.30.78.0/25
HUB_IP=172.30.78.10

# The bundle's internal network of the hub, bitcoind and the Fulcrum Electrum server (no route out). bitcoin.conf
# allows RPC from it too.
ELECTRUM_SUBNET=172.30.78.128/25

# The hub's chain: bitcoin (mainnet) or signet. SatBooth's network settings must name the same chain.
HUB_NETWORK=bitcoin

# Host directory with relay.json, bitcoin.conf, hub.env (0600), fulcrum.conf (0600) and, with the monero profile,
# monerod.conf and wallet-rpc/ (rpc-login and wallet.pass, 0600 each). volume-init gives each file to the user that
# reads it.
HUB_CONFIG_DIR=/srv/satbooth-hub/config

# Host directory with the operator-made view-only wallet (satbooth-view and satbooth-view.keys); without the monero
# profile, any directory (it may be empty).
MONERO_WALLET_DIR=/srv/satbooth-hub/wallet
